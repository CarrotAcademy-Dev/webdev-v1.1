export const getLostnFound1 = async () => {
    try {
        const response = await apiClient.get(ENDPOINT.csoBersama, {
            params: { action: 'data-lostnfound' }
        });

        const result = response.data;

        if (result.status === 'success') {
            const headerItems = [
                { key: 'idTicket', label: 'ID Ticket' },
                { key: 'nama', label: 'Nama' },
                { key: 'nomor', label: 'Nomor' },
                { key: 'kategori', label: 'Kategori' },
                { key: 'requestDetail', label: 'Request Detail' },
                { key: 'pic', label: 'PIC' },
                { key: 'lampiran', label: 'Lampiran' },
                { key: 'hasil', label: 'Hasil' },
                { key: 'done', label: 'Done?' }
            ];

            const formattedOpen = transformRawData(result.dataOpen, headerItems, false);
            const formattedClose = transformRawData(result.dataClose, headerItems, true);

            return {
                dataOpen: formattedOpen,
                dataClose: formattedClose
            };

        } else {
            throw new Error(result.message || 'Failed to fetch data');
        }
    } catch (error) {
        console.error("Error fetching data LostNFound:", error);
        throw error;
    }
};

export const markStoryAsDone1 = async (date) => {
    const params = new URLSearchParams();
    params.append('action', 'done-story');
    params.append('date', date);

    try {
        const response = await apiClient.post(`${ENDPOINT.csoBersama}?${params.toString()}`);
        
        if (response.data.status === 'success') {
            console.log(response.data.message);
            return response.data;
        } else {
            throw new Error(response.data.message || 'Failed to mark as done');
        }
    } catch (error) {
        console.error("Error marking story as done:", error);
        throw error;
    }
};

export const postLostNFound1 = async (rowData) => {
    const body = new FormData();
    body.append('action', 'done-lostnfound');
    body.append('id_ticket', rowData.idTicket);

    try {
        const response = await apiClient.post(ENDPOINT.csoBersama, body);

        const result = response.data;
        if (result.status === 'success') {
            return result;
        } else {
            throw new Error(result.message || 'Failed to submit data');
        }
    } catch (error) {
        console.log("Error posting data lost n found");
        throw error;
    }
}

export const postOffboardingData1 = async (rowData) => {
    const body = new FormData();
    body.append('action', 'ceklis-daftar-offboarding');
    body.append('id_ticket', rowData.id);
    body.append('program', rowData.program);
    body.append('modul', rowData.modul);
    body.append('level', rowData.level);
    body.append('tanggal_mulai_cuti', rowData.tanggalMulaiCuti);
    body.append('tanggal_akhir_cuti', rowData.tanggalAkhirCuti);
    body.append('last_day', rowData.done_lastDay);
    body.append('schedule_dirapihkan', rowData.done_scheduleSudahDirapihkan);
    body.append('reminder_whatsapp', rowData.done_reminderWhatsapp);
    body.append('sertifikat_dikirim', rowData.done_sertifSudahDikirim);
    body.append('progress_report', rowData.done_progressReportSudahDikirim);
    
    try {
        const response = await apiClient.post(ENDPOINT.csoBersama, body);
        
        const result = response.data;
        if (result.status === 'success') {
            return result;
        } else {
            throw new Error(result.message || 'Failed to submit data');
        }
    } catch (error) {
        console.error("Error posting offboarding data:", error);
        throw error;
    }
}

