# API Configuration
VITE_API_BASE_URL=https://script.google.com/macros/s
VITE_API_CSO_BERSAMA_ENDPOINT=https://script.google.com/macros/s/YOUR_CSO_BERSAMA_SCRIPT_ID/exec
VITE_API_CSO_PERSONAL_ENDPOINT=https://script.google.com/macros/s/YOUR_CSO_PERSONAL_SCRIPT_ID/exec
VITE_API_AUTH_ENDPOINT=/YOUR_AUTH_SCRIPT_ID/exec

# App Configuration
VITE_APP_NAME=CarrotAcademy Dashboard
